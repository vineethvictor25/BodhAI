# local: offline demo; openai/anthropic/gemini/groq/deepseek/openai_compatible: one service;
# router: named models and controlled ordered fallback.
PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_FALLBACK_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
LLM_CONFIG_FILE=config/llm_routes.yaml
# Optional overrides for PROVIDER=router; omit to use the YAML policy.
# LLM_PRIMARY_ROUTE=openai_primary
# LLM_FALLBACK_ROUTES=gemini_backup,groq_backup,deepseek_backup
# LLM_ALLOW_CROSS_PROVIDER_FALLBACK=true
# Common settings for any single-service PROVIDER. LLM_MODEL overrides its vendor MODEL.
# Vendor API key takes precedence; LLM_API_KEY is used when that vendor key is absent.
LLM_API_KEY=
LLM_MODEL=
# Only for PROVIDER=openai_compatible: API root, not /chat/completions.
LLM_BASE_URL=
LLM_ALLOW_HTTP_LOOPBACK=false
# Optional single-service capability overrides; omit to use vendor defaults.
# LLM_STRUCTURED_MODE=json_object
# LLM_VISION=false
# LLM_REQUIRE_API_KEY=false
# Leave unset for loopback-only development. Required when binding outside localhost.
APP_API_TOKEN=
DATA_DIR=data
# Column protection: inject keys from a secret store in production.
PII_KEY_PROVIDER=environment
# Base64 of exactly 32 random bytes. Never commit a value here or paste it in chat.
PII_ENCRYPTION_KEY=
PII_HMAC_KEY=
# For azure_key_vault, install requirements.azure.txt and grant managed identity secret-read access.
PII_KEY_VAULT_URL=
# Optional separate step-up token, at least 32 characters; decryption stays disabled when unset.
PII_DECRYPT_TOKEN=
# Exact HTTPS API hostnames allowed for ingestion, comma separated. Public IPs only.
API_ALLOWED_HOSTS=
MAX_UPLOAD_BYTES=5242880
# Durable change notification outbox. SMTP delivery is disabled until configured.
EMAIL_ENABLED=false
EMAIL_NOTIFY_PUBLICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
# Comma-separated plain email addresses, at most 20 recipients.
EMAIL_TO=
