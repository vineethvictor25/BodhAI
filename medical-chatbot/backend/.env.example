# Get a free key from Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# Gemini model to use for chat generation
GEMINI_MODEL=gemini-2.0-flash

# HuggingFace embedding model (runs locally, no API key needed, ~80MB download on first run)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval
RETRIEVAL_K=5

# Storage paths (relative to backend/)
UPLOAD_DIR=data/uploads
CHROMA_DIR=data/chroma_db

# Optional absolute path if Tesseract is not available on PATH
# Windows example:
# TESSERACT_CMD="C:/Program Files/Tesseract-OCR/tesseract.exe"
