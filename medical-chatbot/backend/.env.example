# Copy to .env and set credentials locally; never commit the populated file.
# Obtain a key from Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Set a model available to your account and compatible with the installed SDK.
# An explicit value overrides the legacy default in config.py.
GEMINI_MODEL=

# HuggingFace embedding model (runs locally, no API key needed, ~80MB download on first run)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval
RETRIEVAL_K=5

# Storage paths (relative to backend/)
UPLOAD_DIR=data/uploads
CHROMA_DIR=data/chroma_db

# Set true when serving over HTTPS. Keep false for local HTTP development.
AUTH_COOKIE_SECURE=false
# Optional random signing secret of at least 32 characters; generated locally if blank.
AUTH_SECRET=

# Reminder delivery: email (default), manual_whatsapp, or whatsapp_cloud.
REMINDER_DELIVERY_MODE=email

# SMTP email reminders. Until these are configured and the patient opts in,
# the scheduler will not send email. Use an app password, never your mailbox password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
APP_PUBLIC_URL=http://localhost:5173

# Optional WhatsApp Cloud API medication reminders used only in whatsapp_cloud mode.
# Create an approved Utility template with positional parameters:
# {{1}} medicine name, {{2}} number of doses, {{3}} time-of-day slot, {{4}} food instruction.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=medication_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_API_VERSION=v25.0

# Optional absolute path if Tesseract is not available on PATH
# Windows example:
# TESSERACT_CMD="C:/Program Files/Tesseract-OCR/tesseract.exe"
