# Merge required settings into .env. Never commit real URLs or credential files.
# Merge profiles into a single sources.json and set DATA_SOURCES_FILE=sources.json.
WAREHOUSE_TLS12_ENABLED=true
SQLSERVER_URL=mssql://reader:URL_ENCODED_PASSWORD@sql.example.test:1433/reporting
# One login with SELECT grants on registered tables in DatabaseA and DatabaseB.
SQLSERVER_CROSSDB_URL=mssql://reader:URL_ENCODED_PASSWORD@sql.example.test:1433/DatabaseA
# Optional analytics lab: provision both databases and merge generated mappings/policies first.
# ANALYTICS_LAB_SQLSERVER_URL=mssql://reader:URL_ENCODED_PASSWORD@sql.example.test:1433/AnalyticsCommerce
ORACLE_URL=oracle://reader:URL_ENCODED_PASSWORD@oracle.example.test:1522/?service_name=REPORTING&protocol=tcps
SNOWFLAKE_URL=snowflake://reader:URL_ENCODED_PASSWORD@org-account/REPORTING/ANALYTICS?warehouse=QUERY_WH&role=QUERY_READER
# Works with provisioned or Serverless Redshift endpoints reachable by the app server.
REDSHIFT_URL=redshift://reader:URL_ENCODED_PASSWORD@workgroup.account.region.redshift-serverless.amazonaws.com:5439/reporting?sslmode=verify-full
# Identity uses ADC (attached workload identity preferred); optional key-file fallback below.
BIGQUERY_URL=bigquery://your-gcp-project/analytics?location=US&maximum_bytes_billed=1000000000
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/service-account.json
# Existing PostgreSQL/MySQL adapters also serve managed AWS and GCP databases.
AWS_RDS_POSTGRES_URL=postgresql://reader:URL_ENCODED_PASSWORD@instance.region.rds.amazonaws.com:5432/reporting?sslmode=verify-full
GCP_CLOUDSQL_POSTGRES_URL=postgresql://reader:URL_ENCODED_PASSWORD@127.0.0.1:5432/reporting
