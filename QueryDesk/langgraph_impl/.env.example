# This application reads only its local .env (or NLQ_ENV_FILE), never its parent .env.
LLM_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
LLM_API_STYLE=chat_completions
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=openai/gpt-oss-20b
LLM_STRICT_TOOLS=false
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_SECONDS=90
LLM_SEND_PARALLEL_TOOL_CALLS=true
# Optional agent prefixes: INTENT, SCHEMA, COLUMNS, SQL, VALIDATION, RESPONSE, VISUALIZATION.
# Each supports MODEL, ENDPOINT, API_KEY, API_STYLE, MAX_TOKENS,
# TIMEOUT_SECONDS, STRICT_TOOLS, SEND_PARALLEL_TOOL_CALLS.
# Role MODEL wins over the UI/CLI fallback model choice.
# LLM_INTENT_MODEL=your-small-model
# LLM_INTENT_MAX_TOKENS=1000
# LLM_SCHEMA_MAX_TOKENS=1500
# LLM_COLUMNS_MAX_TOKENS=1500
# LLM_SQL_MODEL=your-larger-model
# LLM_SQL_MAX_TOKENS=4000
# LLM_VALIDATION_MODEL=your-review-model
# LLM_VALIDATION_MAX_TOKENS=2000
# LLM_RESPONSE_MODEL=your-small-model
# LLM_RESPONSE_MAX_TOKENS=1500
# LLM_VISUALIZATION_MODEL=your-chart-planning-model
# LLM_VISUALIZATION_MAX_TOKENS=1500
# LLM_VISUALIZATION_TIMEOUT_SECONDS=45
# Optional post-result chart calls have a separate per-request model-call cap.
VISUALIZATION_MAX_MODEL_CALLS=3
VISUALIZATION_RENDERERS=plotly,matplotlib,seaborn
# A different endpoint requires BOTH its own key and model; approve the
# endpoint/model in MODEL_POLICY_FILE before using it with source data.
# LLM_SQL_ENDPOINT=https://your-approved-provider.example/v1
# LLM_SQL_API_KEY=replace-with-the-role-provider-key
# LLM_SQL_API_STYLE=chat_completions
# LLM_SQL_TIMEOUT_SECONDS=60

# Single API process; pending = active plus queued workflow segments.
QUERY_WORKERS=1
QUERY_MAX_PENDING=3
QUERY_MAX_PER_USER=3
QUERY_MAX_SQL_ATTEMPTS=3
QUERY_MAX_MODEL_CALLS=40
# GROQ_API_KEY / GROQ_MODEL also work when corresponding LLM_* values are absent.

# Optional data sources: copy/edit sources.example.json (paths are relative to this app).
# DATA_SOURCES_FILE=sources.json
# ANALYTICS_POSTGRES_URL=postgresql://readonly_user:URL_ENCODED_PASSWORD@localhost:5432/analytics
# REPORTING_MYSQL_URL=mysql://readonly_user:URL_ENCODED_PASSWORD@localhost:3306/reporting
# Optional developer-defined relevance domains for the sample source:
# DOMAINS_FILE=domains.json
# For other sources, set domains_file in their source profile.

# PII permission checks apply regardless of this at-rest encryption flag.
PII_ENCRYPTION_ENABLED=false
PII_CONFIG_FILE=encryption.json
# Enable secure cookies only behind an HTTPS deployment; local preview uses HTTP.
AUTH_COOKIE_SECURE=false
# Required for first-administrator setup. Generate a random secret of 32–256 characters.
AUTH_SETUP_TOKEN=

# New history expires from submission; old records require an explicit migration decision.
HISTORY_RETENTION_HOURS=24
HISTORY_STORE_RESULT_ROWS=false
# Profiles ship unapproved. Review endpoint/model/data rules before enabling an approval.
MODEL_POLICY_FILE=model_policy.json
ROW_SECURITY_ENABLED=false
ROW_SECURITY_FILE=row_security.json
# Local PII preparation: positive values only; row/byte/cell ceilings cannot be disabled.
PII_MAX_COPY_ROWS=100000
PII_MAX_COPY_BYTES=20000000
PII_MAX_INPUT_BYTES=40000000
PII_MAX_ENVELOPE_BYTES=1000000
PII_MAX_CELL_BYTES=1000000
PII_MAX_DECRYPT_CELLS=500000
PII_COPY_TIMEOUT_SECONDS=10
# false permits unencrypted development SQL connections; cloud APIs still use HTTPS.
WAREHOUSE_TLS12_ENABLED=true
# Optional larger synthetic lab: python -m langgraph_impl.analytics_demo --register-local
# The command merges a local source and source policies without changing existing grants.
# ANALYTICS_LAB_DATABASE=C:/path/to/langgraph_impl/data/analytics_lab/analytics_mirror.db
